{
  "name": "cashalot",
  "version": "1.0.0",
  "private": true,
  "description": "Personal dashboard for tracking income, expenses, and savings.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env server/index.js",
