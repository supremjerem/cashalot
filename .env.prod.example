# Server-side env file for docker-compose.prod.yml.
# Copy to ~/apps/live/cashalot/.env on the VPS and fill in real values —
# never commit the filled-in version.

# Domain this stack is routed under by Traefik.
DOMAIN=cashalot.supremjerem.com

# Pin a specific build instead of always running the latest push to main.
# Find tags at https://github.com/supremjerem/cashalot/pkgs/container/cashalot
IMAGE_TAG=latest

# Database
POSTGRES_PASSWORD=

# Session cookie signing key — generate with: openssl rand -base64 32
SESSION_SECRET=

# App password hash — generate on any machine with Node + this repo's deps:
#   node scripts/hash-password.mjs "your password"
# IMPORTANT: docker compose interpolates `$` in .env files, which corrupts a
# bcrypt hash (it starts with $2a$...). Double every `$` to `$$` here — e.g.
# a hash of $2a$12$abc... must be written as $$2a$$12$$abc...
APP_PASSWORD_HASH=
