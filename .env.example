# Local development env — copy to .env (gitignored).
DATABASE_URL=postgresql://cashalot:cashalot@localhost:5435/cashalot
PORT=3000

# Generate with: openssl rand -base64 32
SESSION_SECRET=dev-only-insecure-secret

# Generate with: node scripts/hash-password.mjs "your password"
# (use the script's first, unescaped output here — this file is read by
# `node --env-file`, not docker compose, so no need to double the `$` signs.
# You may see a harmless "variable is not set" warning from `docker compose
# up` for Postgres — it also reads this file but doesn't use this variable.)
APP_PASSWORD_HASH=
